            {"cam": {"pos": [0.6, 1.7, 6], "look": [3.75, 1.4, 6]}},
            {"s": "nightjar", "t": "The Great Vale. Closing night. The paper's new, but the picture is twelve years old."},
            {"s": "nightjar", "t": "No grin, back then. Just a man in a top hat who looks like he can't believe his luck."},
            {"do": "clue", "flag": "clue_poster", "text": "CLUE: THE POSTER"},
            {"do": "goto", "scene": "flashback"}
          ]
        },
        {
          "id": "musicbox",
          "x": -10,
          "z": -4.9,
          "y": 1.0,
          "label": "Something is playing on the carousel",
          "script": [
            {"cam": {"pos": [-8.2, 2.2, -2.2], "look": [-10, 1, -5.5]}},
            {"s": "nightjar", "t": "A music box, wedged on the carousel platform. Still winding down."},
            {
              "if": "met_mira",
              "then": [
                {"s": "nightjar", "t": "The engraving's worn, but I can read it. 'For Mira. The show goes on.'"},
                {"s": "nightjar", "t": "He gave this to his sister that night. And tonight he put it out where the rain could get at it."}
              ],
              "else": [{"s": "nightjar", "t": "There's an engraving. 'For M-' the rest is worn smooth."}]
            },
            {"do": "clue", "flag": "clue_musicbox", "text": "CLUE: THE MUSIC BOX"}
          ]
        },
        {
          "id": "mirrors",
          "x": -16,
          "z": -13.8,
          "y": 1.6,
          "label": "Try the Hall of Mirrors",
          "repeat": true,
          "script": [
            {"s": "nightjar", "t": "Chained. The chain is new, the door is old, and the scorch marks are older."},
            {
              "if": "saw_flashback",
              "then": [{"s": "nightjar", "t": "This is where it happened. Not tonight, Vale. You don't get to drag me in there yet."}]
            }
          ]
        }
