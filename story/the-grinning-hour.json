            {"s": "nightjar", "t": "A grin. And a promise."},
            {"s": "nightjar", "t": "The Grinning Hour. Every stage magician has a call time."},
            {"do": "clue", "flag": "clue_chalk", "text": "CLUE: THE CHALK"}
