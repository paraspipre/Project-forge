      "npcs": [
        {
          "id": "ibarra",
          "x": 3,
          "z": 8.5,
          "rot": 0,
          "label": "Talk to Commissioner Ibarra",
          "talk": [
            {
              "if": "deduced",
              "then": [
                {"s": "ibarra", "t": "Units are moving on Merriment Park. They'll hold the perimeter, nothing more."},
                {"s": "nightjar", "t": "Keep it that way. He wants an audience. Don't give him one."}
              ],
              "else": [
                {
                  "if": ["clue_ticket", "clue_chalk", "clue_pike"],
                  "then": [
                    {"s": "nightjar", "t": "He didn't break out. He walked out. A coin trick for the orderly, a hand in his pocket for the keys."},
                    {"s": "ibarra", "t": "Misdirection. Twelve years and he's still doing a stage act."},
                    {"s": "nightjar", "t": "And he left us a program. A ticket for Merriment Park. Closing night. Three a.m."},
                    {"s": "nightjar", "t": "'The show starts at the Grinning Hour.' It's an invitation."},
                    {
                      "s": "ibarra",
                      "t": "Merriment Park's been rotting since the fire. Crowe's company bought the land for a casino. Demolition starts Monday."
                    },
                    {
                      "if": "clue_mirror",
                      "then": [
                        {
                          "s": "nightjar",
                          "t": "There's a shard of a carnival mirror in his cell. He kept it twelve years. Whatever happened in that park, he never left it."
                        }
                      ]
                    },
                    {"s": "ibarra", "t": "It's 2:40. That gives you twenty minutes."},
                    {"s": "nightjar", "t": "It gives him twenty minutes. Get your people moving, Commissioner.", "set": "deduced"},
                    {"do": "toast", "text": "CASE CRACKED!"}
                  ],
                  "else": [
                    {
                      "if": "talked_ibarra",
                      "then": [
                        {"s": "ibarra", "t": "Anything? The press will be here before the coroner is."},
                        {"if": "!clue_ticket", "then": [{"s": "ibarra", "t": "His cell's the middle one, door hanging open. My people haven't touched it."}]},
                        {
                          "if": "!clue_pike",
                          "then": [{"s": "ibarra", "t": "The orderly on duty is Pike. He was the last one to see Vale. He's out by the cell block."}]
                        },
                        {"if": "!clue_chalk", "then": [{"s": "ibarra", "t": "And somebody drew on the east wall of the main building. Chalk. Fresh."}]}
                      ],
                      "else": [
                        {"s": "ibarra", "t": "You're late, Nightjar."},
                        {"s": "nightjar", "t": "You called me eleven minutes ago."},
                        {
                          "s": "ibarra",
                          "t": "Then I'm early, and so is he. Harlan Vale walked out of maximum security at eight o'clock tonight. Nobody noticed until midnight."
                        },
                        {
                          "choices": [
                            {
                              "t": "How does a man walk out of Blackmere?",
                              "then": [{"s": "ibarra", "t": "That's the part I'd like you to tell me. No alarms. No broken locks. One open door."}]
                            },
                            {
                              "t": "Who knows he's out?",
                              "then": [{"s": "ibarra", "t": "Us. The night staff. And by sunrise, every paper in Gravenport. 'Grinning Man Escapes' sells well."}]
                            },
                            {
                              "t": "Tell me about Vale.",
                              "then": [
                                {"s": "ibarra", "t": "Stage magician, once. The Great Vale. Packed houses at Merriment Park, back when people went there."},
                                {
                                  "s": "ibarra",
                                  "t": "Then twelve years ago something in him broke. Six people hurt at the Crowe Tower gala. He laughed through the whole trial."
                                }
                              ]
                            }
                          ]
                        },
                        {"s": "ibarra", "t": "Look around. His cell, the orderly, anything that's wrong. You see things my people don't."},
                        {"s": "nightjar", "t": "Your people see fine. They just don't look where he doesn't want them to.", "set": "talked_ibarra"},
                        {"do": "toast", "text": "INVESTIGATE!"}
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "dunn",
          "x": -5,
          "z": 12.5,
          "rot": 100,
          "label": "Talk to Officer Dunn",
          "talk": [
            {
              "if": "deduced",
              "then": [{"s": "dunn", "t": "Car's warm. Gate's open. Go get him."}],
              "else": [
                {"s": "dunn", "t": "Evening, uh... Nightjar. Sir."},
                {"s": "dunn", "t": "My granddad saw the Great Vale once. Said he pulled a dove out of a man's wallet and gave the man back an empty wallet."},
                {"s": "dunn", "t": "Everybody laughed. Except the man."}
              ]
            }
          ]
        },
        {
          "id": "tobias",
          "x": -15,
          "z": -11,
          "rot": 0,
          "label": "Talk to the inmate",
          "talk": [
            {"s": "tobias", "t": "Psst. Bird-man. You're looking for the Magician."},
            {
              "choices": [
                {
                  "t": "Did you see him leave?",
                  "then": [
                    {"s": "tobias", "t": "Saw? Nobody sees. That's the trick. You watch the right hand, he works with the left."},
                    {"s": "tobias", "t": "He'd hum every night. Same little tune. Like a music box winding down."}
                  ]
                },
                {
                  "t": "Did he say where he was going?",
                  "then": [{"s": "tobias", "t": "Home, he said. Back to the big top. 'Can't close a show without the star.'"}]
                },
                {"t": "Go back to sleep.", "then": [{"s": "tobias", "t": "Nobody sleeps tonight. Nobody laughs, either. Not yet."}]}
              ]
            }
          ]
        },
        {
          "id": "pike",
          "x": -10,
          "z": -7.5,
          "rot": 0,
          "if": "wave_yard",
          "label": "Talk to Orderly Pike",
          "talk": [
            {
              "if": "clue_pike",
              "then": [{"s": "pike", "t": "I'm going home. I'm going to sleep with every light on."}],
              "else": [
                {"s": "pike", "t": "Every night at lights-out he did the same trick. A coin over the knuckles, back and forth. Made me guess which hand."},
                {
                  "choices": [
                    {
                      "t": "[Calm] Take your time. What happened tonight?",
                      "then": [
                        {
                          "s": "pike",
                          "t": "Tonight he said, 'Last show, Mister Pike. Watch closely.' So I did. I watched that coin like my life depended on it."
                        },
                        {"s": "pike", "t": "When I looked up, the coin was in my pocket. And my keys weren't."}
                      ]
                    },
                    {
                      "t": "[Press] You handed him the keys, didn't you?",
                      "then": [
                        {
                          "s": "pike",
                          "t": "No! I didn't hand him anything. He took them while I was watching the coin. Twelve years of the same trick, and tonight it worked."
                        },
                        {"s": "pike", "t": "He left me the coin. It's not even silver. It's a token from Merriment Park."},
                        {"set": "pike_token"}
                      ]
                    }
                  ]
                },
                {"s": "nightjar", "t": "He spent twelve years teaching you where to look. Tonight he cashed it in."},
                {"do": "clue", "flag": "clue_pike", "text": "CLUE: THE COIN TRICK"}
              ]
            }
          ]
        }
      ],
      "interactables": [
