          "script": [
            {"cam": {"pos": [0, 3.2, 12], "look": [0, 2, -2]}},
            {"s": "vale_pa", "t": "Ladies and gentlemen, boys and girls, birds of the night! Please find your seats!", "sfx": "laugh"},
            {"s": "vale_pa", "t": "Our first act: three gentlemen with nothing to lose, and they've already lost it!"},
            {"do": "wave", "id": "midway"},
            {"do": "toast", "text": "FIGHT!"}
          ]
        },
        {
          "x": 1.6,
          "z": 6,
          "r": 3,
          "if": ["saw_flashback", "!back_note"],
          "script": [
            {"set": "back_note"},
            {"s": "nightjar", "t": "The fire was never an accident. And Vale was never trying to escape Blackmere."},
            {"s": "nightjar", "t": "He was trying to get back to his stage."},
            {
              "if": "!clue_musicbox",
              "then": [{"s": "nightjar", "t": "That tune from the music box... I've heard it twice tonight. It's coming from the carousel."}]
            }
          ]
        },
        {
          "x": 0,
          "z": -10.5,
          "r": 4,
          "if": ["saw_flashback", "!wave_stage"],
