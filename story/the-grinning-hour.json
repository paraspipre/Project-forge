            {"do": "npcAdd", "id": "crowe", "x": 0, "z": 5.5, "rot": 180},
            {"do": "face", "id": "mira", "target": "crowe"},
            {"cam": {"pos": [-3, 2.2, -1.5], "look": [0, 1.6, 4]}},
            {"s": "crowe", "t": "Mister Vale. Miss Vale. Don't let me interrupt."},
            {"do": "npcMove", "id": "crowe", "x": 0, "z": 2.6, "speed": 1.8, "wait": true},
            {"s": "harlan", "t": "Mister Crowe. Come to buy a ticket? I'm told we're the last show in town."},
            {"s": "crowe", "t": "I've bought the town, Harlan. The papers clear on Monday. The bulldozers come Tuesday."},
            {"s": "crowe", "t": "Your little hall of mirrors goes first. Very expensive glass. Very poorly insured."},
            {
              "choices": [
                {
                  "t": "Please. These people have nowhere else to go.",
                  "then": [{"s": "crowe", "t": "They'll go to my casino. It'll have a magician. Younger. Cheaper."}]
                },
                {
                  "t": "[Joke] Careful, Silas. Stand too close to the mirrors and you'll see what you look like.",
                  "then": [{"s": "crowe", "t": "Funny. Be funny tonight, Harlan. It's the last time anybody's paying for it."}]
                },
                {"t": "Get out of my theatre.", "then": [{"s": "crowe", "t": "My theatre. As of midnight. But please, finish the show."}]}
              ]
            },
            {"do": "npcMove", "id": "crowe", "x": 0, "z": 5.6, "speed": 2},
            {"s": "mira", "t": "Don't. Harlan, look at me. Don't let him take the last show too."},
            {"s": "mira", "t": "I'll set up the mirrors for the finale. Two minutes. Then we give them everything."},
            {"do": "npcMove", "id": "mira", "x": -7, "z": -1, "speed": 2.4, "wait": true},
