      "waves": {
        "midway": {
          "enemies": [
            {"character": "grinner", "x": -3, "z": -1, "rot": 0},
            {"character": "grinner", "x": 3, "z": 0, "rot": 0},
            {"character": "grinner", "x": 0, "z": -4, "rot": 0}
          ],
          "onClear": [
            {"s": "nightjar", "t": "Hired help, painted to look like him. He's not here yet. Or he wants me to think he isn't."},
            {"s": "ibarra_radio", "t": "Nightjar, we're at the perimeter. Thermal shows nothing moving inside but you."},
