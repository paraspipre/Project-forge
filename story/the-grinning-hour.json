          ],
          "onClear": [
            {"cam": {"pos": [4.2, 2.6, -11.0], "look": [0, 2.0, -17.5]}},
            {"do": "smoke", "x": 0, "z": -17.5},
            {"do": "npcAdd", "id": "vale", "x": 0, "z": -17.5, "y": 0.8, "rot": 0},
            {"s": "vale", "t": "Bravo. Bravo! Oh, they never stood a chance, but you made it look like a fight. That's showmanship.", "anim": "laugh"},
            {"s": "nightjar", "t": "It's over, Vale."},
            {"s": "vale", "t": "Over? The house lights haven't even dimmed. Look at this place, bird. This was the happiest square mile in Gravenport."},
            {"s": "vale", "t": "Then a man in a good suit pointed one way, and while everybody looked, he took everything with the other hand."},
            {
              "choices": [
                {
                  "t": "I saw what happened to Mira. I'm sorry.",
                  "once": "c_mira",
                  "set": "vale_empathy",
                  "then": [
                    {"s": "vale", "t": "..."},
                    {
                      "if": "clue_musicbox",
                      "then": [
                        {
                          "s": "vale",
                          "t": "You found her music box. Do you know nobody has said her name to me in twelve years? Not the doctors. Not the judge."
                        },
                        {"s": "vale", "t": "They said 'the incident.' Funny. She'd have hated being an incident. She was a headliner."}
                      ],
                      "else": [{"s": "vale", "t": "Sorry. Everybody's sorry, afterwards. It's the cheapest trick there is."}]
                    }
                  ]
                },
                {
                  "t": "Where is Silas Crowe?",
                  "once": "c_crowe",
                  "then": [
                    {"s": "vale", "t": "Crowe? Mr. Urban Renewal? Oh, he has the best seat in the house. Front row. He just doesn't know it yet."},
                    {"set": "asked_crowe"}
                  ]
                },
                {
                  "t": "Hurting people won't bring her back.",
                  "once": "c_lecture",
                  "then": [
                    {"s": "vale", "t": "Bring her back? Bird, I'm a magician, not a priest. I don't do resurrections. I do reveals."},
                    {"s": "vale", "t": "And tonight, I reveal what this city really is."}
                  ]
                },
                {"t": "Enough talk. [Grab him]", "exit": true}
              ],
              "loop": true
            },
            {"s": "nightjar", "t": "You're coming with me."},
            {"s": "vale", "t": "Ah ah ah. Every good magician knows when to leave the stage..."},
            {"s": "vale", "t": "...and the trick is, you never see the door.", "anim": "laugh"},
            {"do": "npcRemove", "id": "vale", "smoke": true},
            {"do": "shake", "amount": 0.4},
            {"s": "nightjar", "t": "Smoke and a trapdoor. Old as the stage itself."},
            {"s": "ibarra_radio", "t": "Nightjar! Crowe's penthouse... his private security just went dark. All of it, at once."},
            {
              "if": "asked_crowe",
              "then": [{"s": "nightjar", "t": "Front row. This park was the misdirection. Crowe was always the act."}],
              "else": [{"s": "nightjar", "t": "The park was the misdirection. Crowe was always the act."}]
            },
            {"s": "ibarra_radio", "t": "I'm heading there n- *krrsh*"},
            {"s": "vale_pa", "t": "Commissioner! So glad you could make it! There's a ticket with your name on it, too...", "sfx": "laugh"},
            {"do": "fade", "out": true},
            {
              "do": "end",
              "kicker": "END OF CHAPTER ONE",
              "title": "TO BE CONTINUED",
              "text": "Next: Chapter Two, 'The Hall of Mirrors'",
              "stats": [
                {"if": "vale_empathy", "label": "Harlan Vale", "value": "remembers that you said her name"},
                {"if": "!vale_empathy", "label": "Harlan Vale", "value": "thinks you're no different from Crowe"},
                {"if": "pike_saved", "label": "Orderly Pike", "value": "safe"}
              ]
            }
          ]
        }
      },
