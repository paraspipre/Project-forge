          "script": [
            {"cam": {"pos": [3, 2.6, -8], "look": [0, 2.5, -18]}},
            {"s": "vale_pa", "t": "And now, the moment you've all been waiting for! Please welcome... the Big Grin!"},
            {"do": "wave", "id": "stage"},
            {"s": "nightjar", "t": "More of them. He's stalling."},
            {"do": "toast", "text": "FINAL ACT!"}
          ]
        }
